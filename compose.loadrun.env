# The load-run configuration, as a file rather than a memory (P4).
#
# `docker compose` interpolates these from the repo `.env` unless they are in the shell at
# `up` time, so a fleet run started in a fresh terminal quietly measured a server with the LLM
# judge on — billing a reasoning-model call per conversation and adding its latency to the
# window under measurement. The judge gate in tier 1 caught it once; it should not have to.
#
#   docker compose --env-file .env --env-file compose.loadrun.env #     --profile app --profile livekit up -d
#
# **Both files, in that order.** `--env-file` replaces the default `.env` rather than adding to
# it, so this file alone resolves `OPENAI_API_KEY: ""` and the stack comes up without a decider.
# Later files win, so `.env` supplies the secrets and this one overrides the four values a load
# run must pin. Verified with `docker compose ... config`: the four below win and the keys survive.

# No post-call LLM judge: a load run must not bill a reasoning-model call per conversation, and
# the judge's work lands inside the window being measured (O13).
JUDGE_ENABLED=false

# No tracing export: the Langfuse stack competes for the same cores as the voice worker, and a
# starved worker's latency is not the system's latency (see docs/loadtest/README.md).
LANGFUSE_ENABLED=false

# The real decider. A `scripted` run measures the harness, not the product; the SLO segment is
# `channel: voice` + `decider: openai` and nothing else belongs in it.
TURN_DECIDER=openai

# Lets the harness past the per-IP rate limiter, which a fleet of N borrowers from one address
# would otherwise trip. Override it per run; it is not a secret, it is a local bypass.
RATE_LIMIT_BYPASS_TOKEN=feather-lite-loadrun-bypass
