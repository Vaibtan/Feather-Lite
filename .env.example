# Feather-Lite v2 — copy to `.env` at the repo root (loaded by apps/server and apps/voice-worker).
# Everything is optional except DATABASE_URL for anything beyond unit tests.

# --- Postgres (local docker-compose default; or a Neon free-tier URL with ?sslmode=require) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5434/feather_lite
# DB_MAX_CONNECTIONS=10

# --- Conversationalist ---
# scripted = deterministic (scenarios, CI, offline demo); openai = real model per state
TURN_DECIDER=scripted
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_SIMPLE=gpt-4.1-mini      # GREETING / VERIFYING_IDENTITY / VOICEMAIL / ENDING / ...
# LLM_MODEL_COMPLEX=gpt-4.1          # DISCUSSING_PAYMENT / CONFIRMING_OUTCOME

# --- Tracing (Langfuse; omit the keys to disable) ---
# One session per conversation, one span per turn, one nested generation per model call.
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENVIRONMENT=local     # tags every span; e.g. local | staging | production
# Kill switch that leaves the keys in place. Set false before a tier-1 load run: it drives tens of
# thousands of scripted turns and there is no reason to export a span for each one.
# LANGFUSE_ENABLED=false
#
# Mask account facts -- amounts, dates, long digit runs -- in every exported span body. ON by
# default: Langfuse is a second store with its own retention and its own readers. Set false only to
# debug a prompt, and know that it writes the balances and the promise dates to that store.
# TRACE_REDACT_ACCOUNT_DATA=false
#
# Self-hosted Langfuse instead of the cloud (pnpm lf:up; see deploy/langfuse/docker-compose.yml).
# The keys below are created by that compose file's headless initialisation, so they work as-is.
# LANGFUSE_PUBLIC_KEY=pk-lf-feather-lite-local
# LANGFUSE_SECRET_KEY=sk-lf-feather-lite-local
# LANGFUSE_BASE_URL=http://127.0.0.1:3000

# --- LiveKit Cloud (Build tier is free) — needed for live voice calls only ---
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_AGENT_NAME=feather-lite-agent
# LIVEKIT_STT_MODEL=deepgram/nova-3      # LiveKit Inference model strings
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_...    # only for "Dial my phone" (needs a SIP trunk)

# --- Self-hosted LiveKit (pnpm lk:up == docker compose --profile livekit up -d livekit) ---
# Swapping Cloud <-> local is only these lines; no code reads a "which LiveKit" flag.
# SIP/PSTN stays Cloud-only (no livekit-sip locally) — the worker fails the call fast if asked.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=Dt9Jzf0Ix8nNl80YbUKHjJkJIlBSlVET   # must equal deploy/livekit/livekit.yaml keys.devkey
#
# The ICE candidate the SFU advertises, and the one setting a containerised call cannot do without.
# Read by docker-compose.yml, not by any application: `--node-ip ${LIVEKIT_NODE_IP:-127.0.0.1}`.
#
# The default 127.0.0.1 is correct for the browser demo and means *this container* to a worker in
# another one — so a container-to-container call connects and then hears nothing, which is why "a
# container-to-container call is verified" sat on the README's Not-built list until 2026-09-01. Set
# it to a host address both sides can reach (the machine's LAN address: it works from the host and
# from inside Docker Desktop's VM, because the media ports are published on the host). Every voice
# number since 2026-09-01 was measured with it set.
# LIVEKIT_NODE_IP=192.168.1.4
#
# LiveKit Inference is a Cloud-only gateway, so a self-hosted server needs direct provider plugins:
# STT_TTS_PROVIDER=plugins        # inference (default, Cloud) | plugins (Deepgram nova-3 STT + Aura TTS)
# DEEPGRAM_API_KEY=...
# DEEPGRAM_TTS_MODEL=aura-2-asteria-en   # Aura voice for the agent (the voice IS the model)

# --- Voice worker → control plane ---
# CONTROL_PLANE_URL=http://127.0.0.1:8080

# --- Voice worker sizing (spec 2026-08-27 D4/W2) ---
# `pnpm start:worker` runs the worker in production mode; `pnpm dev:worker` does not, and in dev
# mode loadThreshold is Infinity -- the worker can never report itself full and the SFU dispatches
# straight through the CPU ceiling. Every fleet measurement uses `start`, and the fleet harness
# refuses to run against a dev-mode worker without --allow-dev.
#
# The load this worker reports is `activeJobs / WORKER_MAX_JOBS`, not the framework default (a
# five-second CPU average of the whole box, which counts every other process as this worker's load
# and lags a burst by seconds). The threshold is the margin for the SFU learning that number 2.5 s
# late, so the admitted concurrency is floor(MAX_JOBS x THRESHOLD) -- 6 at the defaults below.
#
# **To serve N concurrent calls the ceiling has to be above N.** Measured 2026-09-01: the N=10
# acceptance run configured MAX_JOBS=10 and was assigned NINE calls, because nine active reports a
# load of 0.9 and the SFU stops at 0.75; the tenth finalized NEVER_SERVED without the worker ever
# seeing it. Ten calls need MAX_JOBS=14. `mem_limit` in docker-compose.yml is sized against the
# ceiling, not against the calls, or the ceiling OOM-kills the container it exists to protect.
#
# Both of these are parsed fail-closed: a value that is not a whole number at or above the minimum
# stops the boot with one line on stderr, rather than becoming NaN and silently removing the limit.
# WORKER_MAX_JOBS=8
# WORKER_LOAD_THRESHOLD=0.75
# WORKER_IDLE_PROCESSES=4        # job processes kept warm; default min(MAX_JOBS, 4). A cold start is
#                                # ~2.8 s and it is paid inside the call, not at dispatch. Each warm
#                                # slot costs ~190 MB resident doing nothing. 0 is a real setting and
#                                # now means zero (it used to become 4; patches/README.md, part three).
#
# Per-job memory bounds. `supervised_proc` polls every child every 5 s whether or not these are set,
# so leaving them at 0 bought nothing -- on Windows each poll spawns wmic (measured: 336 ms).
# WORKER_JOB_MEMORY_WARN_MB=400
# WORKER_JOB_MEMORY_LIMIT_MB=800
#
# UV_THREADPOOL_SIZE is set by the worker to min(12, cores) and inherited by the inference and job
# processes at fork. libuv's default of 4 caps the EOU model at ~65 predictions/s; 12 gives ~80.

# --- Public demo hardening ---
# DEMO_MODE=true                 # clock override on /calls/start, /api/demo/* endpoints, rate limits
# API_BEARER_TOKEN=change-me     # when set: required on every mutating route (console: #token=... in the URL)
#                                # set it for the worker too -- it authenticates the turn stream,
#                                # signals and (since C2) the heartbeat; compose passes it to both
# RATE_LIMIT_PER_MINUTE=120      # per-IP budget on /api/calls|conversations|voice
# DAILY_TURN_CAP=5000            # per-process daily cap on turn requests
# RATE_LIMIT_BYPASS_TOKEN=       # a load harness that sends `x-ratelimit-bypass: <this>` skips both
#                                # budgets (counted as `rate_limit_bypassed`). Set the SAME value in
#                                # the harness's env. This is why the two budgets above no longer say
#                                # "raise for load runs": raising them measures a server configured
#                                # differently from the one being described. Leave unset in the demo.

# --- Orphaned-call sweeper (docs/adr/0009, spec 2026-08-26 D6) ---
# A voice worker that dies mid-call leaves the conversation open forever, and the "one live
# conversation per borrower" pre-call rule then blocks that borrower. The sweeper finalizes such a
# call as FAILED with reason ORPHANED. Detection is worker-liveness-based (the worker's heartbeat
# carries the conversations it is serving), and every candidate is confirmed against LiveKit before
# anything is finalized -- that confirmation is what lets the window be ~35-40 s without hanging up
# live calls whose worker is merely slow.
# SWEEPER_ENABLED=true
# ORPHAN_MISSED_HEARTBEATS=3           # heartbeats a conversation may miss before it is a candidate
# ORPHAN_HEARTBEAT_INTERVAL_MS=10000   # must match the worker's heartbeat interval
# ORPHAN_UNCONFIRMED_MS=300000         # when LiveKit cannot be reached, wait this long instead:
#                                      # an outage must degrade into a slower sweep, never a
#                                      # fleet-wide hangup

# --- LLM judge (spec 2026-08-26 D3) ---
# A second model reads each finished call and returns a binary verdict per dimension with a quoted
# piece of evidence. It runs post-call in the outbox, never on the turn path, so a judge outage
# cannot touch a live conversation -- and it costs one model call per call, which is why it is off
# unless you turn it on. Leave it off for CI and for tier-1 load runs.
#
# The model is GPT-5.6 Luna, the efficient tier of the GPT-5.6 family. Do NOT set this to the bare
# `gpt-5.6` alias: OpenAI routes that to Sol, the frontier tier, at a very different price.
# JUDGE_ENABLED=false
# JUDGE_MODEL=gpt-5.6-luna
# JUDGE_REASONING_EFFORT=medium        # low | medium | high
# JUDGE_MAX_TOKENS=4000                # reasoning tokens count against this, not just the answer

# --- Control-plane tuning (spec 2026-08-27 D5) ---
# How many claimed outbox jobs are processed at once. The loop is also work-conserving: a full
# batch means more is waiting, so it claims again immediately instead of sleeping.
# OUTBOX_CONCURRENCY=4
#
# How long a finished turn's frames are kept in memory for a reconnect. This is an optimisation,
# not a correctness requirement -- a client that re-sends a turn_id after the entry has gone gets
# the recorded result replayed from the ledger instead. Five minutes of them was 46 MB/min of
# growth under a 30 turns/s soak.
# TURN_RETENTION_SECONDS=60
#
# CPU-profile this process for N seconds from boot and write a .cpuprofile into PROFILE_DIR, then
# carry on serving. Read it with `node scripts/cpuprof-top.mjs <file>`.
# PROFILE_SECONDS=30
# PROFILE_DIR=./profiles

# --- Server ---
# PORT=8080
# HOST=0.0.0.0
# AGENT_NAME=Ava
# COMPANY_NAME=Feather-Lite Collections
# CALLBACK_NUMBER=+1 800 555 0100

# --- Voice worker: interruption ---
# WORKER_INTERRUPTION_MODE=vad   # vad (default, and what a self-hosted profile can run) | adaptive
#                                # "adaptive" is LiveKit's hosted detector: it 401s here and the
#                                # session silently falls back to VAD, which is why the default says
#                                # so out loud (W1). Set it on LiveKit Cloud.
