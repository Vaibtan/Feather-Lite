# Feather-Lite v2 — copy to `.env` at the repo root (loaded by apps/server and apps/voice-worker).
# Everything is optional except DATABASE_URL for anything beyond unit tests.

# --- Postgres (local docker-compose default; or a Neon free-tier URL with ?sslmode=require) ---
DATABASE_URL=postgres://postgres:postgres@localhost:5434/feather_lite
# DB_MAX_CONNECTIONS=10

# --- Conversationalist ---
# scripted = deterministic (scenarios, CI, offline demo); openai = real model per state
TURN_DECIDER=scripted
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_MODEL_SIMPLE=gpt-4.1-mini      # GREETING / VERIFYING_IDENTITY / VOICEMAIL / ENDING / ...
# LLM_MODEL_COMPLEX=gpt-4.1          # DISCUSSING_PAYMENT / CONFIRMING_OUTCOME

# --- Tracing (Langfuse free tier; omit to disable) ---
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_BASE_URL=https://cloud.langfuse.com

# --- LiveKit Cloud (Build tier is free) — needed for live voice calls only ---
# LIVEKIT_URL=wss://<project>.livekit.cloud
# LIVEKIT_API_KEY=...
# LIVEKIT_API_SECRET=...
# LIVEKIT_AGENT_NAME=feather-lite-agent
# LIVEKIT_STT_MODEL=deepgram/nova-3      # LiveKit Inference model strings
# LIVEKIT_TTS_MODEL=cartesia/sonic-3
# LIVEKIT_TTS_VOICE=9626c31c-bec5-4cca-baa8-f8ba9e84c8bc
# LIVEKIT_SIP_OUTBOUND_TRUNK_ID=ST_...    # only for "Dial my phone" (needs a SIP trunk)

# --- Self-hosted LiveKit (pnpm lk:up == docker compose --profile livekit up -d livekit) ---
# Swapping Cloud <-> local is only these lines; no code reads a "which LiveKit" flag.
# SIP/PSTN stays Cloud-only (no livekit-sip locally) — the worker fails the call fast if asked.
# LIVEKIT_URL=ws://127.0.0.1:7880
# LIVEKIT_API_KEY=devkey
# LIVEKIT_API_SECRET=Dt9Jzf0Ix8nNl80YbUKHjJkJIlBSlVET   # must equal deploy/livekit/livekit.yaml keys.devkey
#
# LiveKit Inference is a Cloud-only gateway, so a self-hosted server needs direct provider plugins:
# STT_TTS_PROVIDER=plugins        # inference (default, Cloud) | plugins (Deepgram STT + Cartesia TTS)
# DEEPGRAM_API_KEY=...
# CARTESIA_API_KEY=...

# --- Voice worker → control plane ---
# CONTROL_PLANE_URL=http://127.0.0.1:8080

# --- Public demo hardening ---
# DEMO_MODE=true                 # clock override on /calls/start, /api/demo/* endpoints, rate limits
# API_BEARER_TOKEN=change-me     # when set: required on every mutating route (console: #token=... in the URL)
# RATE_LIMIT_PER_MINUTE=120      # per-IP budget on /api/calls|conversations|voice; raise for load runs
# DAILY_TURN_CAP=5000            # per-process daily cap on turn requests; raise for load runs

# --- Server ---
# PORT=8080
# HOST=0.0.0.0
# AGENT_NAME=Ava
# COMPANY_NAME=Feather-Lite Collections
# CALLBACK_NUMBER=+1 800 555 0100
