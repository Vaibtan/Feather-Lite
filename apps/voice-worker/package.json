{
  "name": "@feather-lite/voice-worker",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "LiveKit Agents worker: media adapter whose llmNode streams the control-plane turn.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tracer": "tsx src/tracer/agent.ts dev",
    "tracer:token": "tsx src/tracer/token-server.ts",
    "text-run": "tsx src/tracer/text-run.ts",
    "lk-smoke": "tsx src/tracer/lk-smoke.ts",
    "build": "node ../../scripts/bundle.mjs apps/voice-worker/src/agent.ts apps/voice-worker/dist/agent.js",
    "dev": "tsx src/agent.ts dev",
    "start": "node dist/agent.js start",
    "fake-borrower": "tsx src/tracer/fake-borrower.ts",
    "fake-borrower-fleet": "tsx src/tracer/fake-borrower-fleet.ts",
    "chaos-orphan": "tsx src/tracer/chaos-orphan.ts",
    "shed-probe": "tsx src/tracer/shed-probe.ts",
    "vad-cost": "tsx src/tracer/vad-cost.ts"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@livekit/agents": "1.6.4",
    "@livekit/agents-plugin-deepgram": "1.6.4",
    "@livekit/rtc-node": "^0.13.33",
    "dotenv": "^17.2.1",
    "effect": "^3.22.1",
    "livekit-server-sdk": "^2.17.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@feather-lite/contracts": "workspace:*",
    "@feather-lite/domain": "workspace:*",
    "@feather-lite/load-test": "workspace:*",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
