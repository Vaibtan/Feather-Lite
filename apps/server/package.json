{
  "name": "@feather-lite/server",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Node entry point: HttpApi server + in-process schedulers.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "build": "node ../../scripts/bundle.mjs apps/server/src/main.ts apps/server/dist/main.js",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js"
  },
  "dependencies": {
    "@effect/platform": "^0.97.1",
    "@effect/platform-node": "^0.108.1",
    "@effect/sql": "^0.52.1",
    "@effect/sql-pg": "^0.53.0",
    "@langfuse/client": "^5.10.1",
    "@langfuse/otel": "^5.10.1",
    "@langfuse/tracing": "^5.10.1",
    "@opentelemetry/resources": "^2.10.0",
    "@opentelemetry/sdk-trace-node": "^2.10.0",
    "@prometheus-io/client": "^0.16.1",
    "dotenv": "^17.2.1",
    "effect": "^3.22.1",
    "livekit-server-sdk": "^2.17.0",
    "openai": "^6.49.0",
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@feather-lite/contracts": "workspace:*",
    "@feather-lite/control-plane": "workspace:*",
    "@feather-lite/domain": "workspace:*",
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
