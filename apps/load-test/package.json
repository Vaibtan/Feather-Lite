{
  "name": "@feather-lite/load-test",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Load harnesses for the control plane (tier 1) and the resource sampler both tiers report with. Plain tsx scripts, no framework.",
  "exports": {
    "./resources": {
      "types": "./src/resources.ts",
      "default": "./src/resources.ts"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "tier1": "tsx src/tier1.ts",
    "idle": "tsx src/idle-sample.ts"
  },
  "dependencies": {
    "postgres": "^3.4.7"
  },
  "devDependencies": {
    "@types/node": "^22.17.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
