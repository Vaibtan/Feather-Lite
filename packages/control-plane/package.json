{
  "name": "@feather-lite/control-plane",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "description": "Effect services: persistence, orchestrator, turn deciders, tools, call control, workflows, scheduling, outbox, tracing; HttpApi implementation.",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
