{
  "name": "feather-lite",
  "private": true,
  "version": "2.0.0",
  "description": "Feather-Lite v2: collections voice-agent platform (TypeScript + Effect + LiveKit Agents)",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "pnpm -r --if-present typecheck",
    "test": "pnpm -r --if-present test",
    "test:db": "pnpm -r --if-present test:db",
    "lint": "pnpm -r --if-present lint",
    "check": "pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "lk:up": "docker compose --profile livekit up -d livekit",
    "lk:down": "docker compose --profile livekit stop livekit",
    "lf:up": "docker compose -f deploy/langfuse/docker-compose.yml -p feather-lite-langfuse up -d",
    "lf:down": "docker compose -f deploy/langfuse/docker-compose.yml -p feather-lite-langfuse stop",
    "loadtest:tier1": "pnpm --filter @feather-lite/load-test tier1",
    "loadtest:tier2": "pnpm --filter @feather-lite/voice-worker fake-borrower-fleet",
    "dev": "pnpm --parallel --filter @feather-lite/server --filter @feather-lite/voice-worker --filter @feather-lite/console dev",
    "dev:server": "pnpm --filter @feather-lite/server dev",
    "dev:worker": "pnpm --filter @feather-lite/voice-worker dev",
    "dev:console": "pnpm --filter @feather-lite/console dev",
    "start:server": "pnpm --filter @feather-lite/server start",
    "start:worker": "pnpm --filter @feather-lite/voice-worker start",
    "console:build": "pnpm --filter @feather-lite/console build",
    "deploy:console": "pnpm console:build && npx wrangler pages deploy apps/console/dist --project-name feather-lite-console",
    "tunnel": "cloudflared tunnel --url http://127.0.0.1:8080"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "@effect/vitest": "^0.30.0",
    "tsx": "^4.20.5"
  }
}
